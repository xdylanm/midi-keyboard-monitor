{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PracticePlan",
  "type": "object",
  "required": ["name","mode","key","scaleType","octaves","hand","tempoBpm","accuracyPercent"],
  "properties": {
    "version": { "type": "string", "default": "1.0" },
    "name": { "type": "string" },
    "mode": { "type": "string", "enum": ["constant","variable"] },
    "key": { "type": "string" },
    "scaleType": { "type": "string", "enum": ["major","minor"] },
    "minorVariant": { "type": "string", "enum": ["natural","harmonic","melodic"], "default": "natural" },
    "octaves": { "type": "integer", "enum": [1,2] },
    "hand": { "type": "string", "enum": ["LH","RH","HT"] },
    "tempoBpm": { "type": "integer", "minimum": 20, "maximum": 300 },
    "accuracyPercent": { "type": "integer", "minimum": 10, "maximum": 100 },
    "chordMode": { "type": "string", "enum": ["mean","per-voice"], "default": "mean" },
    "handSplit": {
      "type": "object",
      "properties": {
        "strategy": { "type": "string", "enum": ["automatic"], "default": "automatic" },
        "splitMidiNote": { "type": "integer", "minimum": 0, "maximum": 127, "default": 60 }
      },
      "required": ["strategy"]
    },
    "constantTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "intensityLabel": { "type": "string", "enum": ["pp","p","mp","mf","f","ff"] }
        },
        "required": ["intensityLabel"]
      }
    },
    "variableTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startIntensity": { "type": "string", "enum": ["pp","p","mp","mf","f","ff"] },
          "endIntensity": { "type": "string", "enum": ["pp","p","mp","mf","f","ff"] },
          "direction": { "type": "string", "enum": ["crescendo","decrescendo"] }
        },
        "required": ["startIntensity","endIntensity"]
      }
    },
    "notesPerMeasure": { "type": "integer", "default": 4 }
  },
  "additionalProperties": false
}
